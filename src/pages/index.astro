---
import Layout from "../layouts/Layout.astro";
import data from "../data/accueil.json";

const { hero, intro, univers, feat, experience, immersive, cta } = data;
---
<Layout title={"Coiffure & maquillage mariage à Laval | Constance"} description={"Constance sublime vos plus beaux moments : coiffure, maquillage et créations sur-mesure pour votre mariage à Laval, en Mayenne et Pays de la Loire. Demandez votre devis."} ogImage={"/images/hero-mariee-dos.webp"}>
  <div class="wrap">
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">{hero.eyebrow}</p>
        <h1>{hero.title}</h1>
        <p class="lead">{hero.lead}</p>
        <div class="hero-actions">
          <a href={hero.primaryHref} class="btn btn-primary">{hero.primaryLabel}</a>
          <a href={hero.ghostHref} class="btn btn-ghost">{hero.ghostLabel}</a>
        </div>
      </div>
      <div class="hero-media"><div class="frame"><span class="tape"></span>
        <img fetchpriority="high" width="1100" height="1100" src={hero.image} alt={hero.imageAlt}>
        <span class="sig">creartist</span></div></div>
    </section>
  </div>
  <div class="ribbon" aria-hidden="true"><div class="ribbon__track">
    <span><b>Coiffure</b><i>—</i><b>Maquillage</b><i>—</i><b>Coiffe sur-mesure</b><i>—</i><b>Ornements</b><i>—</i><b>Mariage</b><i>—</i><b>Laval</b><i>—</i></span>
    <span><b>Coiffure</b><i>—</i><b>Maquillage</b><i>—</i><b>Coiffe sur-mesure</b><i>—</i><b>Ornements</b><i>—</i><b>Mariage</b><i>—</i><b>Laval</b><i>—</i></span>
  </div></div>
  <section class="reveal"><div class="wrap intro">
    <div class="intro-media"><div class="frame"><span class="pin"></span>
      <img src={intro.image} alt={intro.imageAlt}></div></div>
    <div>
      <span class="script">{intro.script}</span>
      <h2>{intro.name}</h2>
      <p class="lead">{intro.paragraph1}</p>
      <p class="lead" style="margin-top:16px">{intro.paragraph2}</p>
      <div style="margin-top:30px"><a href={intro.buttonHref} class="btn btn-ghost">{intro.buttonLabel}</a></div>
    </div>
  </div></section>
  <section class="band-kraft"><div class="wrap">
    <div class="sec-head reveal"><p class="eyebrow">{univers.eyebrow}</p><h2>{univers.title}</h2></div>
    <div class="univ-grid">
      {univers.cards.map((card) => (
        <article class={card.feature ? "card feature reveal" : "card reveal"}>
          <figure><img src={card.image} alt={card.imageAlt}></figure>
          <div class="body">
            {card.tag && <span class="tagpill">{card.tag}</span>}
            <h3>{card.title}</h3>
            <p>{card.text}</p>
            {card.linkLabel && <div style="margin-top:18px"><a href={card.linkHref} class="btn btn-ghost">{card.linkLabel}</a></div>}
          </div>
        </article>
      ))}
    </div>
  </div></section>
  <section class="reveal"><div class="wrap feat">
    <div class="feat-media"><div class="frame"><img src={feat.image} alt={feat.imageAlt}></div></div>
    <div>
      <p class="eyebrow">{feat.eyebrow}</p>
      <h2>{feat.title}</h2>
      <p class="lead">{feat.lead}</p>
      <a href={feat.buttonHref} class="btn btn-primary">{feat.buttonLabel}</a>
      <div class="arrow-note"><svg viewBox="0 0 46 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M2 20 C 14 20, 30 16, 42 5"/><path d="M34 4 L43 4 L42 13"/></svg>{feat.note}</div>
    </div>
  </div></section>
  <section class="band-kraft"><div class="wrap">
    <div class="sec-head reveal"><p class="eyebrow">{experience.eyebrow}</p><h2>{experience.title}</h2></div>
    <div class="exp-grid">
      {experience.items.map((item) => (
        <div class="exp reveal">
          <div class="big">{item.count ? (<><span data-count={item.count}>0</span> {item.unit}</>) : item.bigText}</div>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </div>
      ))}
    </div>
  </div></section>
  <section class="immersive reveal" aria-label="Ma philosophie">
    <div class="immersive__bg"><img src={immersive.image} alt={immersive.imageAlt} loading="lazy"></div>
    <div class="immersive__veil"></div>
    <div class="wrap immersive__in">
      <span class="script">{immersive.script}</span>
      <blockquote>{immersive.quote}</blockquote>
      <cite>{immersive.cite}</cite>
    </div>
  </section>
  <section class="band-kraft reveal"><div class="wrap cta">
    <h2>{cta.title}</h2>
    <p class="lead">{cta.lead}</p>
    <div class="cta-actions"><a href={cta.buttonHref} class="btn btn-primary">{cta.buttonLabel}</a>
      <a href={cta.instagramUrl} class="iglink" target="_blank" rel="noopener"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none"/></svg>{cta.instagramLabel}</a></div>
    <p class="geo">{cta.geo}</p>
  </div></section>
</Layout>
